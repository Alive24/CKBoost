{
  "name": "ckboost-dapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:claimable-pool-lock-dep": "pnpm --dir node_modules/ckb-claimable-pool-lock exec tsc -p tsconfig.build.json",
    "sync:tinymce": "node ./postinstall.mjs",
    "predev": "pnpm run sync:tinymce",
    "prebuild": "pnpm run sync:tinymce && bash ./pre-build.sh && pnpm run build:claimable-pool-lock-dep && cd ../packages/ssri-ckboost && pnpm install && pnpm build",
    "build": "pnpm run prebuild && next build --webpack",
    "postbuild": "rm -rf public/_pagefind && pagefind --site .next/server/app --output-path public/_pagefind",
    "dev": "netlify dev",
    "lint": "next lint",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "backfill:nostr-relays": "node ./scripts/backfill-nostr-relays.mjs",
    "canary:nostr": "node ./scripts/nostr-canary.mjs",
    "postinstall": "node ./postinstall.mjs"
  },
